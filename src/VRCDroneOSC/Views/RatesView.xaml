<UserControl x:Class="VRCDroneOSC.Views.RatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VRCDroneOSC.Controls"
             Background="{StaticResource BgMediumBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
        <StackPanel>

            <!-- ── Throttle ── -->
            <Border Background="{StaticResource BgPanelBrush}"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="THROTTLE"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Mid" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding ThrottleMid, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Expo" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding ThrottleExpo, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Pitch ── -->
            <Border Background="{StaticResource BgPanelBrush}"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="PITCH"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding PitchCenter, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Max Rate" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding PitchMaxRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Expo" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding PitchExpo, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:RateCurveGraph Grid.Column="2"
                        Height="80"
                        Center="{Binding PitchCenter}"
                        MaxRate="{Binding PitchMaxRate}"
                        Expo="{Binding PitchExpo}"
                        CurrentInput="{Binding PitchCurrentInput}"/>
                </Grid>
            </Border>

            <!-- ── Roll ── -->
            <Border Background="{StaticResource BgPanelBrush}"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ROLL"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding RollCenter, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Max Rate" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding RollMaxRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Expo" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding RollExpo, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:RateCurveGraph Grid.Column="2"
                        Height="80"
                        Center="{Binding RollCenter}"
                        MaxRate="{Binding RollMaxRate}"
                        Expo="{Binding RollExpo}"
                        CurrentInput="{Binding RollCurrentInput}"/>
                </Grid>
            </Border>

            <!-- ── Yaw ── -->
            <Border Background="{StaticResource BgPanelBrush}"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="YAW"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding YawCenter, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Max Rate" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding YawMaxRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F1}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Expo" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox Width="80"
                                     Text="{Binding YawExpo, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F3}}"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:RateCurveGraph Grid.Column="2"
                        Height="80"
                        Center="{Binding YawCenter}"
                        MaxRate="{Binding YawMaxRate}"
                        Expo="{Binding YawExpo}"
                        CurrentInput="{Binding YawCurrentInput}"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
