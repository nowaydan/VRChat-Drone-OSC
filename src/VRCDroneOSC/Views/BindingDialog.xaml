<Window x:Class="VRCDroneOSC.Views.BindingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Binding Editor"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CornerRadius="12"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- Outer rounded border — same shape as MainWindow -->
    <Border CornerRadius="12"
            Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom title bar -->
                <RowDefinition Height="36"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Grid Grid.Row="0"
                  Background="{StaticResource BgDarkBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Binding Editor"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="✕"
                        Width="46"
                        HorizontalAlignment="Right"
                        Click="CancelClick"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Close"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="13"/>
            </Grid>

            <!-- ── Content ── -->
            <Grid Grid.Row="1" Margin="20,12,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Form fields -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgMediumBrush}"
                        CornerRadius="4" Padding="16">
                    <StackPanel>

                        <!-- Binding Name -->
                        <TextBlock Text="Binding Name" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName" Margin="0,0,0,14"/>

                        <!-- Parameter Address -->
                        <TextBlock Text="Parameter Address" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddress" Margin="0,0,0,14"/>

                        <!-- Controller Input -->
                        <TextBlock Text="Controller Input" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbInput" Margin="0,0,0,14">
                            <ComboBoxItem Content="Axis 0 (Left X)"   Tag="Axis0"/>
                            <ComboBoxItem Content="Axis 1 (Left Y)"   Tag="Axis1"/>
                            <ComboBoxItem Content="Axis 2 (Right X)"  Tag="Axis2"/>
                            <ComboBoxItem Content="Axis 3 (Right Y)"  Tag="Axis3"/>
                            <ComboBoxItem Content="Axis 4 (L2)"       Tag="Axis4"/>
                            <ComboBoxItem Content="Axis 5 (R2)"       Tag="Axis5"/>
                            <ComboBoxItem Content="Button 0"          Tag="Btn0"/>
                            <ComboBoxItem Content="Button 1"          Tag="Btn1"/>
                            <ComboBoxItem Content="Button 2"          Tag="Btn2"/>
                            <ComboBoxItem Content="Button 3"          Tag="Btn3"/>
                            <ComboBoxItem Content="Button 4"          Tag="Btn4"/>
                            <ComboBoxItem Content="Button 5"          Tag="Btn5"/>
                            <ComboBoxItem Content="Button 6"          Tag="Btn6"/>
                            <ComboBoxItem Content="Button 7"          Tag="Btn7"/>
                        </ComboBox>

                        <!-- Normalization -->
                        <TextBlock Text="Normalization" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbNormalize" Margin="0,0,0,14">
                            <ComboBoxItem Content="None"             Tag="None"/>
                            <ComboBoxItem Content="Zero to One"      Tag="ZeroToOne"/>
                            <ComboBoxItem Content="Minus One to One" Tag="MinusOneToOne"/>
                            <ComboBoxItem Content="Binary"           Tag="Binary"/>
                        </ComboBox>

                        <!-- Behavior -->
                        <TextBlock Text="Behavior" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBehavior">
                            <ComboBoxItem Content="Continuous" Tag="Continuous"/>
                            <ComboBoxItem Content="Toggle"     Tag="Toggle"/>
                            <ComboBoxItem Content="One Shot"   Tag="OneShot"/>
                        </ComboBox>

                    </StackPanel>
                </Border>

                <!-- Bottom buttons -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Validation message -->
                    <TextBlock x:Name="TxtValidation"
                               Grid.Column="0"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <Button Grid.Column="1"
                            Content="Save"
                            Style="{StaticResource AccentButton}"
                            Width="90"
                            Click="SaveClick"/>

                    <Button Grid.Column="3"
                            Content="Cancel"
                            Width="90"
                            Click="CancelClick"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
