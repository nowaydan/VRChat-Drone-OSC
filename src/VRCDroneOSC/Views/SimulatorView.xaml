<UserControl x:Class="VRCDroneOSC.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media3d="clr-namespace:System.Windows.Media.Media3D;assembly=PresentationCore"
             Background="{StaticResource BgMediumBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 3D Viewport ── -->
        <Border Grid.Row="0"
                Background="{StaticResource BgDarkBrush}"
                CornerRadius="4"
                ClipToBounds="True">
            <Viewport3D x:Name="Viewport">

                <!-- Camera -->
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Cam"
                                       Position="0,5,-10"
                                       LookDirection="0,-0.45,1"
                                       UpDirection="0,1,0"
                                       FieldOfView="60"/>
                </Viewport3D.Camera>

                <!-- Directional light -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <DirectionalLight Color="White" Direction="-1,-2,-1"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Ambient light so the underside isn't pitch black -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#FF404060"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- Grid floor (20x20 plane of thin quads) -->
                <ModelVisual3D x:Name="GridFloor"/>

                <!-- Drone model (small cross-shaped mesh) -->
                <ModelVisual3D x:Name="DroneVisual">
                    <ModelVisual3D.Transform>
                        <Transform3DGroup x:Name="DroneTransform">
                            <RotateTransform3D x:Name="DroneRotate">
                                <RotateTransform3D.Rotation>
                                    <QuaternionRotation3D x:Name="DroneQuat"/>
                                </RotateTransform3D.Rotation>
                            </RotateTransform3D>
                            <TranslateTransform3D x:Name="DroneTranslate"/>
                        </Transform3DGroup>
                    </ModelVisual3D.Transform>
                </ModelVisual3D>

            </Viewport3D>
        </Border>

        <!-- ── Bottom bar ── -->
        <Border Grid.Row="1"
                Background="{StaticResource BgDarkBrush}"
                CornerRadius="4"
                Padding="12,6"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Simulator is an approximation — in-game feel may differ"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="TxtPos"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <Button Content="Reset"
                            Padding="12,4"
                            Command="{Binding ResetSimulatorCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
